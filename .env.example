# Slack App Credentials
# You can find these in the "Basic Information" section of your Slack App
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Spotify App Credentials
# Find these in your Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# The public URL where this bot is hosted (e.g. your ngrok URL or Render URL)
# Do not include a trailing slash!
PUBLIC_URL=https://your-bot-url.ngrok-free.app

# Optional Configuration
STATUS_EMOJI=:headphones:
